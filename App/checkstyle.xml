<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Deliberately minimal (Day 23): checks real hygiene/correctness issues only, not formatting/style.
    The codebase has no established formatting convention yet, so a strict style ruleset (indentation,
    brace placement, line length) would fail broadly on day one for reasons unrelated to code quality.
    This can grow stricter later once the team agrees on a style.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="EmptyCatchBlock"/>
    </module>
</module>
