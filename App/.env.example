# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.
# docker-compose.yml only reads JWT_SECRET_KEY/JWT_EXPIRATION_TIME from here; DATABASE_*/REDIS_* are
# hardcoded there to match the postgres/redis containers it also starts. This file matters when running
# the app natively (./mvnw spring-boot:run) instead of via docker-compose.

DATABASE_URL=jdbc:postgresql://localhost:5432/waypoint
DATABASE_USERNAME=waypoint_user
DATABASE_PASSWORD=waypoint_pass

REDIS_HOST=localhost
REDIS_PORT=6379

# Any random 32+ character string. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
# 7200000 = 2 hours, in milliseconds
JWT_EXPIRATION_TIME=7200000

LOGGING_LEVEL_ROOT=INFO

# Set to true only when served over HTTPS (e.g. Render). Keep false for local http.
COOKIE_SECURE=false
